{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nullbyte",
  "version": "0.1.0",
  "identifier": "fr.nullbyte.app",
  "build": {
    "beforeDevCommand": "pnpm run build:sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:sidecar:release && pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "title": "Nullbyte",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nullbyte-emu"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
